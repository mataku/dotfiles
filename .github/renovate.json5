{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'Asia/Tokyo',
  rangeStrategy: 'replaced',
  rebaseWhen: 'conflicted',
  minimumReleaseAge: '7 days',
  packageRules: [
    {
      matchUpdateTypes: [
        'major',
        'patch',
        'minor',
      ],
      groupName: 'GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      automerge: true,
      platformAutomerge: true,
    },
  ],
  enabledManagers: [
    'github-actions',
  ],
}
